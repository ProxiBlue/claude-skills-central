# Email backup for monitor alerts — copy to ~/.config/monitor-notify.env and fill.
# Until this file exists at ~/.config/monitor-notify.env, alerts are desktop-only
# (still logged to ~/monitor/alerts.log + the dashboard regardless).
#
# Uses curl SMTP (no MTA needed). Works with any SMTP-over-TLS provider.
#   NOTIFY_EMAIL_TO   where alerts go (e.g. lucas@proxiblue.com.au)
#   SMTP_URL          smtps://<host>:465   (implicit TLS)  OR  smtp://<host>:587 (STARTTLS)
#   SMTP_USER         SMTP username (usually the full email address)
#   SMTP_PASS         SMTP password / app-password
#
# NOTE: these are SMTP (send) creds — NOT the IMAP (read) creds the graphiti
# email-ingest uses. Same mailbox, different service/port.

export NOTIFY_EMAIL_TO="lucas@proxiblue.com.au"
export SMTP_URL="smtps://mail.example.com:465"
export SMTP_USER="lucas@proxiblue.com.au"
export SMTP_PASS="CHANGE-ME"
