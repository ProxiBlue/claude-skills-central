# Email backup for monitor alerts — copy to ~/.config/monitor-notify.env.
# Until that file exists, alerts are desktop-only (still logged to
# ~/monitor/alerts.log + the dashboard regardless).
#
# Uses Resend's HTTP API — the same provider ai_assistant/webhooks already uses.
# To avoid duplicating the API key, this SOURCES it live from the project .env,
# so the secret stays in exactly one place. If that project moves, update the
# path (or paste the key directly instead of sourcing).

# --- source the Resend key from the existing ai_assistant .env ---------------
if [ -f "$HOME/workspace/proxiblue/ai_assistant/.env" ]; then
  # shellcheck disable=SC1091
  RESEND_API_KEY=$(grep -E '^RESEND_API_KEY=' "$HOME/workspace/proxiblue/ai_assistant/.env" | head -1 | cut -d= -f2- | tr -d '"'"'"' ')
  export RESEND_API_KEY
fi

# Where alerts go, and the verified sender (Resend requires a verified domain;
# proxiblue.com.au is already verified for the booking agent).
export NOTIFY_EMAIL_TO="lucas@proxiblue.com.au"
export RESEND_FROM_EMAIL="monitor <noreply@proxiblue.com.au>"
