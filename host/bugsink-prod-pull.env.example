# bugsink-prod-pull config — copy to ~/.config/bugsink-prod-pull.env
# SSH alias (from ~/.ssh/config) of the PRODUCTION host. READ-ONLY use.
PULL_SSH_HOST=
# Comma-separated absolute paths of logs to pull (Magento: var/log/exception.log)
PULL_REMOTE_LOGS=
# DSN of the bugsink project the events land in (see ~/.pb-hcf/bugsink.env → BUGSINK_DSN_PPS_PROD)
PULL_DSN=
PULL_ENVIRONMENT=production
PULL_MAX_EVENTS=50
