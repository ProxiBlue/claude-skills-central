{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "proxiblue-skills:billing-invoice": "on",
    "hcf:plan-create": "on",
    "hcf:plan-orchestrate": "on",
    "hcf:project-setup": "on",
    "hcf:project-update": "on"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/lucas/claude-skills-central/hooks/pre-commit-audit.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/merge-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/git-tree-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/gh-comment-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/php-debug-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/playwright-trace-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/gate-config-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/test-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/perf-gate.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/webfetch-completeness-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/lucas/claude-skills-central/hooks/post-commit-wiki-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/test-failure-context.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/test-evidence.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/playwright-trace-mark.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/invisible-unicode-scrub.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/lucas/claude-skills-central/hooks/invisible-unicode-read-check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/lucas/claude-skills-central/scripts/statusline-combined.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pb-graphiti@pb-graphiti": true,
    "pb-chatroom@pb-chatroom": true,
    "hcf@hcf": true
  },
  "extraKnownMarketplaces": {
    "hcf": {
      "source": {
        "source": "github",
        "repo": "markshust/hcf"
      }
    }
  },
  "pluginConfigs": {
    "pb-graphiti@pb-graphiti": {
      "options": {
        "graphiti_url": "http://localhost:8765/mcp"
      }
    }
  },
  "tui": "default",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: Not queryable — no git remotes configured for this repo; assume private",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — origin/HEAD unset, no remotes configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo only (no remotes configured) — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /home/lucas/workspace/uptactics — the git repository the agent started in (working directory); no remotes are configured, so there is no corroborated remote scope to extend trust to",
      "**Org-specific CLIs**: None configured",
      "No routine-under-<user>/ prefix qualifiers found"
    ]
  }
}
