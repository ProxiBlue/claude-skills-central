  "statusLine": {
    "type": "command",
    "command": "bash /var/www/html/.claude/scripts/statusline-combined.sh"
  },
  "autoApproveTools": [
    "Read(/var/www/html/**)",
    "Bash(ddev exec:*)",
    "Bash(git:*)",
    "Bash(composer:*)",
    "Bash(bin/magento:*)",
    "database/*",
    "magento2-dev/*"
  ],
  "autoMode": {
    "allow": [
      "$defaults",
      "rm on Magento cache/artifact trees under /var/www/html/var/cache/, /var/www/html/var/page_cache/, /var/www/html/var/view_preprocessed/, /var/www/html/pub/static/, /var/www/html/generated/code/, /var/www/html/generated/metadata/ (and their same-name relative equivalents when CWD is /var/www/html) is pre-authorized routine Magento cache cleanup. These paths hold regenerated artifacts, never source code or user data; a nuclear clear followed by cache:flush + setup:upgrade is a well-known Magento troubleshooting sequence. Do NOT flag as 'Dangerous rm operation on critical path' \u2014 the paths are explicitly authorized by the operator via ~/claude-skills-central/settings.json."
    ]
  },
  "mcpServers": {
    "git": true,
    "database": true,
    "magento2-dev": true,
    "github": true,
    "playwright": true,
    "context7": true
  },
